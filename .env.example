# MongoDB Connection String (Note: Database name should be 'vefaDB')
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vefaDB?retryWrites=true&w=majority

# Secret key for server-side encryption
ENCRYPTION_KEY=your-secure-encryption-key-here

# Secret key for cookies
COOKIE_SECRET=your-secure-cookie-secret-here

# Google OAuth (Optional if already configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
